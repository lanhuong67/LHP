@model WebBanDienThoai.Models.AccountLoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="phone-page">

    <h2 class="product-section-title">
        Tài khoản khách hàng <span>✧</span>
    </h2>

    <div style="max-width:560px; margin:40px auto 120px auto; background:white; border-radius:32px; padding:40px; box-shadow:0 10px 28px rgba(0,0,0,.08);">

        <div style="text-align:center; margin-bottom:28px;">
            <div style="width:84px; height:84px; margin:0 auto 18px auto; border-radius:26px; background:#e8f2f4; display:flex; align-items:center; justify-content:center; font-size:44px;">
                👤
            </div>

            <div style="font-size:34px; font-weight:1000; color:#153747;">
                Đăng nhập
            </div>

            <div style="color:#8a99a3; margin-top:8px; font-weight:700;">
                Đăng nhập bằng số điện thoại và mật khẩu.
            </div>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 style="color:#d9534f; font-weight:800; margin-bottom:14px;">
            </div>

            <div style="margin-bottom:18px;">
                <label style="font-weight:900; color:#153747;">Số điện thoại</label>

                <input asp-for="SDT"
                       class="form-control"
                       placeholder="VD: 0909123456"
                       style="height:54px; border-radius:18px; margin-top:8px;" />

                <span asp-validation-for="SDT" class="text-danger"></span>
            </div>

            <div style="margin-bottom:22px;">
                <label style="font-weight:900; color:#153747;">Mật khẩu</label>

                <input asp-for="MatKhau"
                       type="password"
                       class="form-control"
                       placeholder="Nhập mật khẩu"
                       style="height:54px; border-radius:18px; margin-top:8px;" />

                <span asp-validation-for="MatKhau" class="text-danger"></span>
            </div>

            <button type="submit"
                    class="checkout-btn"
                    style="width:100%;">
                Đăng nhập
            </button>

            <a asp-controller="Account"
               asp-action="Register"
               style="display:block; text-align:center; margin-top:16px; font-weight:900; color:#0f4b5c;">
                Chưa có tài khoản? Đăng ký
            </a>

            <a asp-controller="Order"
               asp-action="Lookup"
               style="display:block; text-align:center; margin-top:10px; font-weight:900; color:#8a99a3;">
                Chỉ muốn tra cứu đơn hàng?
            </a>
        </form>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}