@model List<WebBanDienThoai.Models.ChiNhanhWeb>

@{
    ViewData["Title"] = "Cửa hàng";
}

<div class="phone-page">

    <h2 class="product-section-title">
        Hệ thống cửa hàng <span>✧</span>
    </h2>

    <section style="background:white; border-radius:32px; padding:34px; box-shadow:0 8px 20px rgba(0,0,0,.08); margin-bottom:28px;">
        <div style="display:grid; grid-template-columns: 1.1fr .9fr; gap:28px; align-items:center;">
            <div>
                <div style="color:#b78b5d; font-weight:1000; text-transform:uppercase; margin-bottom:8px;">
                    LHP Mobile Store
                </div>

                <div style="font-size:42px; font-weight:1000; color:#153747; line-height:1.08; margin-bottom:16px;">
                    Tìm cửa hàng<br />
                    gần bạn nhất
                </div>

                <p style="color:#7c8c95; font-size:17px; line-height:1.7; margin-bottom:0;">
                    Xem danh sách chi nhánh đang hoạt động trong hệ thống.
                    Khi đặt hàng online, đơn hàng sẽ được xử lý tại chi nhánh có sản phẩm trong giỏ.
                </p>
            </div>

            <div style="background:#e8f2f4; border-radius:28px; padding:28px; min-height:220px; display:flex; flex-direction:column; justify-content:center;">
                <div style="font-size:62px; margin-bottom:8px;">
                    🏬
                </div>

                <div style="font-size:24px; font-weight:1000; color:#0f4b5c;">
                    @Model.Count chi nhánh
                </div>

                <div style="color:#6f858d; font-weight:700; margin-top:6px;">
                    Sẵn sàng hỗ trợ mua hàng, nhận máy và bảo hành.
                </div>
            </div>
        </div>
    </section>

    @if (Model == null || Model.Count == 0)
    {
            <div style="background:white; border-radius:28px; padding:38px; text-align:center; box-shadow:0 8px 20px rgba(0,0,0,.08);">
                <div style="font-size:52px;">🏬</div>
                <div style="font-size:26px; font-weight:1000; color:#153747; margin-top:10px;">
                    Chưa có chi nhánh
                </div>
                <div style="color:#8a99a3; margin-top:8px;">
                    Hiện chưa tìm thấy dữ liệu chi nhánh trong hệ thống.
                </div>
            </div>
    }
    else
    {
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:22px;">
            @foreach (var cn in Model)
            {
                        <div style="background:white; border-radius:28px; padding:24px; box-shadow:0 8px 20px rgba(0,0,0,.08); border:1px solid #f0ebe4;">

                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:14px; margin-bottom:18px;">
                                <div>
                                    <div style="font-size:13px; color:#b78b5d; font-weight:1000; text-transform:uppercase;">
                                        Chi nhánh
                                    </div>

                                    <div style="font-size:24px; font-weight:1000; color:#153747; line-height:1.2;">
                                @cn.TenChiNhanh
                                    </div>
                                </div>

                                <div style="width:52px; height:52px; border-radius:18px; background:#e8f2f4; display:flex; align-items:center; justify-content:center; font-size:28px;">
                                    🏬
                                </div>
                            </div>

                            <div style="background:#f8fafb; border-radius:18px; padding:14px; margin-bottom:12px;">
                                <div style="font-size:12px; color:#8a99a3; font-weight:900; text-transform:uppercase;">
                                    Mã chi nhánh
                                </div>
                                <div style="font-weight:900; color:#153747;">
                            @cn.MaChiNhanh
                                </div>
                            </div>

                            <div style="background:#f8fafb; border-radius:18px; padding:14px; margin-bottom:12px;">
                                <div style="font-size:12px; color:#8a99a3; font-weight:900; text-transform:uppercase;">
                                    Địa chỉ
                                </div>
                                <div style="font-weight:800; color:#153747;">
                            @(string.IsNullOrWhiteSpace(cn.DiaChi) ? "Đang cập nhật" : cn.DiaChi)
                                </div>
                            </div>

                            <div style="background:#f8fafb; border-radius:18px; padding:14px; margin-bottom:18px;">
                                <div style="font-size:12px; color:#8a99a3; font-weight:900; text-transform:uppercase;">
                                    Số điện thoại
                                </div>
                                <div style="font-weight:900; color:#153747;">
                            @(string.IsNullOrWhiteSpace(cn.SDT) ? "Đang cập nhật" : cn.SDT)
                                </div>
                            </div>

                            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                                <a asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-maChiNhanh="@cn.MaChiNhanh"
                                   style="flex:1; text-align:center; padding:13px 16px; border-radius:999px; background:#0f4b5c; color:white; font-weight:1000; text-decoration:none;">
                                    Xem sản phẩm
                                </a>

                                <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(cn.DiaChi ?? cn.TenChiNhanh)"
                                   target="_blank"
                                   style="flex:1; text-align:center; padding:13px 16px; border-radius:999px; background:#e8f2f4; color:#0f4b5c; font-weight:1000; text-decoration:none;">
                                    Bản đồ
                                </a>
                            </div>
                        </div>
            }
            </div>
    }
</div>